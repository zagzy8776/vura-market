# Vura Marketplace — environment variables
# Copy this file to `.env` (which is gitignored) and fill in the real values.

# Backend (Neon Postgres) — used by the serverless API routes.
# Example: postgresql://neon:<password>@ep-cool-darkness-123456.us-east-1.aws.neon.tech/vura_market?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE

# Cloudinary unsigned upload (browser -> Cloudinary, no secret required)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
