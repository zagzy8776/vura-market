# Vura Marketplace — environment variables
# Never commit real secrets. Configure these in Vercel for Preview and Production.

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?sslmode=require

# Vura application
APP_URL=https://your-domain.example

# Site owner (admin). First login with these credentials creates the admin account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Vura Owner

# Resend transactional email (server-only; never use VITE_*)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Vura <orders@your-verified-domain.example>

# Cloudinary unsigned upload (browser -> Cloudinary, no secret required)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# Safe test database for integration tests. Never point this at production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_DB_HOST:5432/TEST_DATABASE?sslmode=require

# OneSignal web push (server + client)
# Create app at https://onesignal.com — Web platform
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# Same App ID exposed to the browser (required for subscribe)
VITE_ONESIGNAL_APP_ID=
