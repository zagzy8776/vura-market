# Vura Marketplace — environment variables
# Never commit real secrets.

# ─── Shared ───────────────────────────────────────────────
# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/DATABASE?sslmode=require

# Public site URL (Vercel frontend)
APP_URL=https://vura-market.vercel.app

# ─── Vercel (frontend) ────────────────────────────────────
# Leave empty to call same-origin /api (Vercel serverless).
# Set to Fly when Fly is the API host:
#   VITE_API_BASE_URL=https://vura-market.fly.dev
VITE_API_BASE_URL=

# Cloudinary unsigned upload (browser → Cloudinary)
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# OneSignal (browser)
VITE_ONESIGNAL_APP_ID=

# ─── Fly.io (API gateway / backend) ───────────────────────
# Upstream API used by Fly proxy until native handlers run on Fly
API_ORIGIN=https://vura-market.vercel.app
# Redirect shoppers away from Fly UI to the real storefront
FRONTEND_URL=https://vura-market.vercel.app
# Browser origins allowed to call the Fly API with credentials
CORS_ORIGIN=https://vura-market.vercel.app

# ─── Server / admin ───────────────────────────────────────
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_NAME=Vura Owner

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Vura <orders@your-verified-domain.example>

ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Safe test database for integration tests. Never point this at production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@TEST_DB_HOST:5432/TEST_DATABASE?sslmode=require
