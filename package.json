{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:api": "tsc --noEmit -p tsconfig.api.json",
    "test": "vitest",
    "test:run": "vitest run",
    "integration": "tsx scripts/integration-test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:validate-migrations": "tsx scripts/validate-migrations.ts",
    "db:verify": "tsx scripts/verify-schema.ts",
    "db:check-migrations": "tsx scripts/check-migrations-status.ts",
    "db:migration-readiness": "tsx scripts/verify-migration-readiness.ts",
    "db:migration-analysis": "tsx scripts/detailed-migration-analysis.ts",
    "db:fix-v13": "tsx scripts/fix-v13-mismatch.ts",
    "db:fix-migrations": "tsx scripts/fix-migration-versions.ts",
    "build:worker": "esbuild api/_lib/agents/worker-entry.ts --bundle --platform=node --format=esm --outfile=agent-worker.mjs",
    "build:fly": "vite build && npm run build:worker"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vercel/node": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.8",
    "vitest": "^4.1.11",
    "esbuild": "^0.25.0"
  }
}
